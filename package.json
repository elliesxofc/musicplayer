{
  "name": "moonlit",
  "productName": "moonlit",
  "version": "1.2.2",
  "description": "a little private music player, just for you",
  "author": "elliesxofc",
  "license": "UNLICENSED",
  "private": true,
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.github.elliesxofc.moonlit",
    "productName": "moonlit",
    "copyright": "made for elliesxofc",
    "files": [
      "index.html",
      "style.css",
      "app.js",
      "sw.js",
      "manifest.webmanifest",
      "icons/**",
      "desktop/**",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "moonlit",
      "artifactName": "moonlit-setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "moonlit-portable-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.music",
      "icon": "icons/icon-512.png"
    },
    "linux": {
      "target": "AppImage",
      "category": "Audio",
      "icon": "icons/icon-512.png"
    },
    "fileAssociations": [
      {
        "ext": "mp3",
        "name": "MP3 audio",
        "description": "MP3 audio (moonlit)",
        "role": "Viewer",
        "icon": "icons/audio-file.ico"
      },
      {
        "ext": "m4a",
        "name": "MPEG-4 audio",
        "description": "MPEG-4 audio (moonlit)",
        "role": "Viewer",
        "icon": "icons/audio-file.ico"
      },
      {
        "ext": "aac",
        "name": "AAC audio",
        "description": "AAC audio (moonlit)",
        "role": "Viewer",
        "icon": "icons/audio-file.ico"
      },
      {
        "ext": "flac",
        "name": "FLAC audio",
        "description": "FLAC audio (moonlit)",
        "role": "Viewer",
        "icon": "icons/audio-file.ico"
      },
      {
        "ext": "wav",
        "name": "WAV audio",
        "description": "WAV audio (moonlit)",
        "role": "Viewer",
        "icon": "icons/audio-file.ico"
      },
      {
        "ext": "ogg",
        "name": "Ogg audio",
        "description": "Ogg audio (moonlit)",
        "role": "Viewer",
        "icon": "icons/audio-file.ico"
      },
      {
        "ext": "opus",
        "name": "Opus audio",
        "description": "Opus audio (moonlit)",
        "role": "Viewer",
        "icon": "icons/audio-file.ico"
      },
      {
        "ext": "aiff",
        "name": "AIFF audio",
        "description": "AIFF audio (moonlit)",
        "role": "Viewer",
        "icon": "icons/audio-file.ico"
      }
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ]
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "spotify-url-info": "3.3.3"
  }
}
